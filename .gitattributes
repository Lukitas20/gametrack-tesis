# Normaliza los finales de línea a LF en el repositorio.
# Sin esto, un colaborador en Windows y otro en Linux/macOS generan diffs
# completos sobre archivos que nadie tocó.
* text=auto eol=lf

# Binarios: nunca convertir.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.db binary
*.sqlite3 binary
*.pkl binary
*.joblib binary

# Estos artefactos auditados deben conservar sus bytes también con autocrlf.
backend/models/review_model.json -text whitespace=cr-at-eol
backend/models/review_model.npz -text
