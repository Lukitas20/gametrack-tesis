# Copiar a backend/.env y ajustar. Todos los valores tienen un default
# razonable en app/core/config.py, así que este archivo es opcional.

# SQLite (por defecto, no requiere instalar nada).
# DATABASE_URL=sqlite:///./gametrack.db
# PostgreSQL (requiere descomentar psycopg2-binary en requirements.txt).
# DATABASE_URL=postgresql+psycopg2://gametrack:gametrack@localhost:5432/gametrack

SECRET_KEY=cambiar-por-una-clave-de-al-menos-32-caracteres
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Opcional: habilita importar el catálogo real desde RAWG
# (scripts/seed_data.py --source rawg). Se obtiene en https://rawg.io/apidocs
RAWG_API_KEY=

# Opcional. Importar la ficha de un juego (POST /steam/import/{appid}) NO
# necesita clave. Sí la necesitan consultar la biblioteca de un usuario y
# traer su perfil. Se obtiene en https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# Índice oficial + fichas en segundo plano mientras la app está abierta.
# STEAM_CATALOG_WORKER_ENABLED=true
# STEAM_CATALOG_PAGE_SIZE=10000
# STEAM_CATALOG_INTERVAL_MINUTES=60
# STEAM_CATALOG_DETAIL_BATCH_SIZE=5
# STEAM_CATALOG_REQUEST_DELAY_SECONDS=2

ENVIRONMENT=development

# Opcional: artefacto entrenado en CPU con scripts/train_local_model.py.
# Relativo al directorio desde el que se inicia el backend; no requiere API key.
# LOCAL_MODEL_PATH=data/generated/local_model.npz
