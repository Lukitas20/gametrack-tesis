# Copiar a deploy/.env en el servidor. Nunca subir ese archivo.
# Generar claves diferentes con: python -c "import secrets; print(secrets.token_hex(32))"
# Para POSTGRES_PASSWORD usar hexadecimal (se incorpora a DATABASE_URL).
POSTGRES_PASSWORD=
SECRET_KEY=
STEAM_API_KEY=

# La API se publica sólo en loopback: usar proxy HTTPS o un túnel SSH.
HTTP_BIND=127.0.0.1
HTTP_PORT=8000

STEAM_CATALOG_PAGE_SIZE=10000
STEAM_CATALOG_INTERVAL_MINUTES=60
STEAM_CATALOG_DETAIL_BATCH_SIZE=5
STEAM_CATALOG_REQUEST_DELAY_SECONDS=2
